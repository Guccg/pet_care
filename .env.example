# Use Supabase Dashboard > Project Settings > Database > Connection string > Session pooler.
# Do not use the Direct connection URL like db.<project-ref>.supabase.co.
SUPABASE_SESSION_POOLER_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# The backend also accepts this name if you prefer a more explicit variable.
# SUPABASE_POSTGRES_SESSION_POOL_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
